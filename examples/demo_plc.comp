component demo_plc "Local node PLC prototype";
option singleton yes;
license "MIT";
pin in float pressure;
pin out bit pump;
function update;
;;
#ifndef pump_set
#define pump_set(...) (pump = (__VA_ARGS__))
#endif
#include <math.h>
static double lpn_div(double a,double b){return fabs(b)>1e-12?a/b:0.0;}
static double lpn_mod(double a,double b){if(fabs(b)<=1e-12 || !isfinite(a) || !isfinite(b))return 0.0;double r=fmod(a,b);return r!=0.0 && ((r<0.0)!=(b<0.0))?r+b:r;}
static double lpn_s32(double x){return isfinite(x)?trunc(fmin(fmax(x,-2147483648.0),2147483647.0)):0.0;}
static double lpn_u32(double x){return isfinite(x)?trunc(fmin(fmax(x,0.0),4294967295.0)):0.0;}
static double lpn_clamp(double x,double l,double h){return fmin(fmax(x,l),h);}
FUNCTION(update) {
  double lpn_dt = period * 1e-9;
  double lpn_n1; /* input: node 1 */
  lpn_n1 = (pressure);
  double lpn_n2; /* math: node 2 */
  lpn_n2 = (((lpn_n1) * (2.0)));
  double lpn_n3; /* condition: node 3 */
  lpn_n3 = !!((((lpn_n2) >= (5.0))));
  double lpn_n4; /* output: node 4 */
  static int lpn_out4=0;
  static double lpn_elapsed4=0;
  int lpn_wanted4=!!(lpn_n3);
  lpn_elapsed4=lpn_wanted4!=lpn_out4?lpn_elapsed4+lpn_dt:0;
  if(lpn_wanted4!=lpn_out4 && lpn_elapsed4>=(lpn_wanted4?0.2:1.0)) {lpn_out4=lpn_wanted4;lpn_elapsed4=0;}
  lpn_n4=lpn_out4 ^ 0;
  pump_set(lpn_n4);
}
